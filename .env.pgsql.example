# PostgreSQL Test Database (isolated, never production)
# Copy this to .env.pgsql and adjust values for your local PostgreSQL instance.
# These are consumed by phpunit-pgsql.xml via config/database.php -> pgsql_test.

PGSQL_TEST_HOST=127.0.0.1
PGSQL_TEST_PORT=5433
PGSQL_TEST_DATABASE=testdb
PGSQL_TEST_USERNAME=testuser
PGSQL_TEST_PASSWORD=testpass
